# Copy to .env and adjust.
# Don't set PORT here: create-react-app also reads .env and would clash with the API.
# The API defaults to 4000 (Heroku etc. set PORT themselves).
SESSION_SECRET=change-me

# Local MongoDB (e.g. docker run -d --name smart-brain-mongo -p 27017:27017 mongo:7)
MONGODB_URI=mongodb://127.0.0.1:27017/smart-brain

# Or MongoDB Atlas (used when MONGODB_URI is not set):
# DB_HOST=cluster0.xxxxx.mongodb.net
# DB_USER=
# DB_PASS=
# DB_NAME=smart-brain
